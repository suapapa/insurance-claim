# OpenAI 호환 비전 LLM 엔드포인트 (LiteLLM 등)
LLM_BASE_URL=http://172.16.0.200:4000/v1
LLM_API_KEY=sk-xxx...xxxx
# 서류를 읽을 비전 모델
VISION_MODEL=gemini-flash-latest
# 분류/추출 호출당 보낼 최대 이미지 수
MAX_IMAGES_PER_CALL=10
# reasoning+JSON 합산 출력 한도 (thinking 모델은 16384+ 권장)
MAX_TOKENS=16384
# Qwen thinking (기본 true). false면 enable_thinking 끔
ENABLE_THINKING=true
# thinking 유지 시 추론 강도: low | medium | xhigh
REASONING_EFFORT=low
# 데이터 저장 경로 (기본: ./data)
# INSURANCE_DATA_DIR=/path/to/data
